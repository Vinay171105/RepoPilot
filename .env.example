# Any OpenAI-compatible endpoint works: Ollama, vLLM, llama.cpp server, LM Studio,
# or a hosted open-model API (check what Alan AI exposes and put its URL/key here).
REPOPILOT_LLM_BASE_URL=http://localhost:11434/v1
REPOPILOT_LLM_API_KEY=none
REPOPILOT_LLM_MODEL=llama3.1:8b

# auto = sentence-transformers if installed, else a built-in offline hashing embedder
REPOPILOT_EMBED_BACKEND=auto
REPOPILOT_EMBED_MODEL=BAAI/bge-small-en-v1.5
REPOPILOT_DATA_DIR=~/.repopilot
